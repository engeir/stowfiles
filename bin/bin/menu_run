#!/usr/bin/env bash

if [[ -n $WAYLAND_DISPLAY ]]; then
    "$HOME"/bin/fuzzel_run
else
    DMENU_ARGS=(-c -nb "#2d2d2d" -nf "#7070c2" -sb "#8c8cd0" -sf "#2d2d2d" -l 20 -fn "CaskaydiaMono Nerd Font:size=14")
    sel=$({
        dmenu_path
        flatpak list --app --columns=application,name | sed $'s/\t/ — /'
    } | sort -u \
        | dmenu "${DMENU_ARGS[@]}") || exit 0

    appid=${sel%%[[:space:]]*}
    if flatpak info "$appid" &>/dev/null; then
        flatpak run "$appid"
    else
        exec sh -c "$sel"
    fi
fi
