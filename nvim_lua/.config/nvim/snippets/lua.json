{
  "local-gitlab-schema": {
    "body": [
      "-- curl -L -o ~/.local/share/yaml-schemas/gitlab-ci.json https://gitlab.com/gitlab-org/gitlab-foss/-/raw/master/app/assets/javascripts/editor/schema/ci.json",
      "local schema_dir = vim.fn.expand(\"~/.local/share/yaml-schemas/\")",
      "",
      "-- url-pattern (Lua pattern matched against the remote schema URL) -> { local file, glob(s)  }",
      "local overrides = {",
      "    { match = \"gitlab.*ci%.json\", file = \"gitlab-ci.json\", glob = \".gitlab-ci.yml\" },",
      "    { match = \"inventory%.json\", file = \"inventory.json\", glob = { \"inventory/**/*.yml\", \"inventory.yml\" } },",
      "}",
      "",
      "vim.api.nvim_create_autocmd(\"LspAttach\", {",
      "    callback = function(args)",
      "        local client = vim.lsp.get_client_by_id(args.data.client_id)",
      "        if not client or client.name ~= \"yamlls\" then",
      "            return",
      "        end",
      "",
      "        local settings = client.settings or {}",
      "        settings.yaml = settings.yaml or {}",
      "        local schemas = vim.deepcopy(settings.yaml.schemas or {})",
      "",
      "        for _, o in ipairs(overrides) do",
      "            -- drop remote schema(s)",
      "            for url in pairs(schemas) do",
      "                if url:match(o.match) then",
      "                    schemas[url] = nil",
      "                end",
      "            end",
      "            -- add local one",
      "            schemas[\"file://\" .. schema_dir .. o.file] = o.glob",
      "        end",
      "",
      "        settings.yaml.schemas = schemas",
      "        client.settings = settings",
      "        client.notify(\"workspace/didChangeConfiguration\", { settings = settings })",
      "    end,",
      "})"
    ],
    "prefix": "local-gitlab-schema"
  },
  "optsss": {
    "body": "opts = {},",
    "prefix": "optsss"
  }
}
